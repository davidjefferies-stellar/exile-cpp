    <!-- Game / particles -->
    <ClCompile Include="src\particles\particle_system.cpp">       <Filter>Game\particles</Filter> </ClCompile>

    <!-- Game / audio -->
    <ClCompile Include="src\audio\audio.cpp">                     <Filter>Game\audio</Filter> </ClCompile>
    <ClCompile Include="src\audio\fenster_audio_impl.c">          <Filter>Game\audio</Filter> </ClCompile>

    <!-- Game / emu -->
    <ClCompile Include="src\emu\jsbeeb_bridge.cpp">               <Filter>Game\emu</Filter> </ClCompile>

    <!-- Game / game -->
    <ClCompile Include="src\game\game.cpp">                       <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\game_debug.cpp">                 <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\config.cpp">                     <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\save_load.cpp">                  <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\tertiary_spawn.cpp">             <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\object_update.cpp">              <Filter>Game\game</Filter> </ClCompile>
    <ClCompile Include="src\game\render.cpp">                     <Filter>Game\game</Filter> </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="tests\test_harness.h">                    <Filter>Tests</Filter> </ClInclude>
    <ClInclude Include="src\rendering\null_renderer.h">           <Filter>Game\rendering</Filter> </ClInclude>
  </ItemGroup>
</Project>
