    <ClCompile Include="src\behaviours\creature.cpp">             <Filter>Game\behaviours</Filter> </ClCompile>
    <ClCompile Include="src\behaviours\robot.cpp">                <Filter>Game\behaviours</Filter> </ClCompile>
    <ClCompile Include="src\behaviours\environment.cpp">          <Filter>Game\behaviours</Filter> </ClCompile>
