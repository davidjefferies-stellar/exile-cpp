    <ClCompile Include="src\player\player_sprite.cpp">            <Filter>Game\player</Filter> </ClCompile>

    <!-- Game / rendering -->
    <ClCompile Include="src\rendering\camera.cpp">                <Filter>Game\rendering</Filter> </ClCompile>
    <ClCompile Include="src\rendering\pixel_renderer.cpp">        <Filter>Game\rendering</Filter> </ClCompile>
    <ClCompile Include="src\rendering\pixel_renderer_debug.cpp">  <Filter>Game\rendering</Filter> </ClCompile>
    <ClCompile Include="src\rendering\fenster_impl.cpp">          <Filter>Game\rendering</Filter> </ClCompile>
    <ClCompile Include="src\rendering\sprite_atlas.cpp">          <Filter>Game\rendering</Filter> </ClCompile>
