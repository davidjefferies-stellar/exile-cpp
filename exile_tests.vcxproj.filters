<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- IDE folders for exile_tests. Two top-level groups:
         Tests : the test runner + every *_test.cpp
         Game  : the src/ files compiled into the test exe (read-only
                 mirror of the layout in exile.vcxproj.filters)
       Keeps the tests visible without scrolling past 40+ game source
       files. -->
  <ItemGroup>
    <Filter Include="Tests">
      <UniqueIdentifier>{b0010001-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game">
      <UniqueIdentifier>{b0010002-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\core">
      <UniqueIdentifier>{b0010003-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\world">
      <UniqueIdentifier>{b0010004-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\objects">
      <UniqueIdentifier>{b0010005-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\behaviours">
      <UniqueIdentifier>{b0010006-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\player">
      <UniqueIdentifier>{b0010007-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\rendering">
      <UniqueIdentifier>{b0010008-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\particles">
      <UniqueIdentifier>{b0010009-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\audio">
      <UniqueIdentifier>{b001000a-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\game">
      <UniqueIdentifier>{b001000b-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\emu">
      <UniqueIdentifier>{b001000c-0000-0000-0000-00000000001b}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <!-- Tests -->
    <ClCompile Include="tests\main.cpp">                          <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\boot_test.cpp">                     <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\walking_gate_test.cpp">             <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\random_test.cpp">                   <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\fixed_point_test.cpp">              <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\weapons_test.cpp">                  <Filter>Tests</Filter> </ClCompile>
    <ClCompile Include="tests\npc_combat_test.cpp">               <Filter>Tests</Filter> </ClCompile>

    <!-- Game / core -->
    <ClCompile Include="src\core\random.cpp">                     <Filter>Game\core</Filter> </ClCompile>

    <!-- Game / world -->
    <ClCompile Include="src\world\landscape.cpp">                 <Filter>Game\world</Filter> </ClCompile>
    <ClCompile Include="src\world\landscape_cpp.cpp">             <Filter>Game\world</Filter> </ClCompile>
    <ClCompile Include="src\world\obstruction.cpp">               <Filter>Game\world</Filter> </ClCompile>
    <ClCompile Include="src\world\wind.cpp">                      <Filter>Game\world</Filter> </ClCompile>
    <ClCompile Include="src\world\water.cpp">                     <Filter>Game\world</Filter> </ClCompile>
    <ClCompile Include="src\world\tertiary.cpp">                  <Filter>Game\world</Filter> </ClCompile>

    <!-- Game / objects -->
    <ClCompile Include="src\objects\object.cpp">                  <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\object_manager.cpp">          <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\physics.cpp">                 <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\collision.cpp">               <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\tile_collision.cpp">          <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\held_object.cpp">             <Filter>Game\objects</Filter> </ClCompile>
    <ClCompile Include="src\objects\weapon.cpp">                  <Filter>Game\objects</Filter> </ClCompile>

    <!-- Game / behaviours -->
    <ClCompile Include="src\behaviours\npc_helpers.cpp">          <Filter>Game\behaviours</Filter> </ClCompile>
    <ClCompile Include="src\behaviours\path.cpp">                 <Filter>Game\behaviours</Filter> </ClCompile>
    <ClCompile Include="src\behaviours\mood.cpp">                 <Filter>Game\behaviours</Filter> </ClCompile>
    <ClCompile Include="src\behaviours\behavior_dispatch.cpp">    <Filter>Game\behaviours</Filter> </ClCompile>
